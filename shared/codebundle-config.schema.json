{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codebundle.local/schemas/codebundle-config.schema.json",
  "title": "CodeBundle Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["projectRoot", "outputFile", "format", "mode"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "projectRoot": {
      "type": "string",
      "minLength": 1
    },
    "outputFile": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "type": "string",
      "enum": ["markdown", "text"]
    },
    "mode": {
      "type": "string",
      "enum": ["selected", "include", "all"]
    },
    "files": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "folders": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "include": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "exclude": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "maxFileSizeKb": {
      "type": "integer",
      "minimum": 1,
      "default": 500
    },
    "skipBinaryFiles": {
      "type": "boolean",
      "default": true
    },
    "respectGitIgnore": {
      "type": "boolean",
      "default": true
    },
    "followSymlinks": {
      "type": "boolean",
      "default": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "mode": { "const": "include" } },
        "required": ["mode"]
      },
      "then": {
        "required": ["include"],
        "properties": {
          "include": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ]
}
